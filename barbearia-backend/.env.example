DB_NAME=Barbearia_Cortae_DB
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_SSL=false
PORT=3000

# Segurança (OBRIGATÓRIO em produção)
# Segredo que assina os tokens de login. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Vazio em desenvolvimento = segredo temporário (todos saem ao reiniciar). Nunca envie o valor real para o GitHub.
JWT_SECRET=
# Sites que podem usar a API pelo navegador (separados por vírgula).
# Vazio = localhost + barberflow-frontend no Azure + GitHub Pages.
# CORS_ORIGINS=https://barberflow-frontend.azurewebsites.net
# Atrás de proxy (Azure já é detectado sozinho): número de proxies na frente da API
# TRUST_PROXY=1
# Geocodificação (OpenStreetMap/Nominatim) - transforma o endereço em latitude/longitude
# para calcular a barbearia mais próxima. Não precisa de chave.
# GEOCODING_USER_AGENT=BarberFlow/1.0 (seu-email@exemplo.com)
# GEOCODING_DESABILITADO=false

# E-mail (notificações para clientes e para a barbearia) - qualquer servidor SMTP.
# Gmail: crie uma "senha de app" em https://myaccount.google.com/apppasswords
# Sem estas variáveis os e-mails são apenas simulados (aparecem no console).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seuemail@gmail.com
# SMTP_PASS=senha-de-app-de-16-letras
# SMTP_FROM=seuemail@gmail.com
# Horário do resumo diário enviado à barbearia (horário de Brasília)
# RESUMO_DIARIO_HORA=07:00

# E-mail da equipe de suporte: recebe as mensagens do formulário "Entre em contato" da Home.
# A mensagem chega com "Responder para" = e-mail de quem escreveu (é só clicar em Responder).
# Vazio = usa o SMTP_USER.
# SUPORTE_EMAIL=barberflow@gmail.com

# Venda de planos (Mercado Pago - Checkout Pro). Passo a passo no README.
# Credenciais em https://www.mercadopago.com.br/developers/panel/app > sua aplicação.
# Use primeiro as credenciais de TESTE (o Access Token começa com TEST- ou APP_USR de usuário de teste).
# MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
# Chave secreta dos webhooks (Suas integrações > Webhooks > "Assinatura secreta")
# MP_WEBHOOK_SECRET=
# Endereço do site (volta do pagamento e link do e-mail com o login) e da API (aviso do pagamento)
# FRONTEND_URL=https://barberflow-frontend.azurewebsites.net
# BACKEND_URL=https://barberflow-backend-ahfcbtcpf7azc0ec.brazilsouth-01.azurewebsites.net
# Demonstração sem Mercado Pago: "Adquirir" leva a uma página que aprova o pagamento de mentira.
# NUNCA use em produção (é ignorado quando NODE_ENV=production).
# PAGAMENTO_SIMULADO=false
