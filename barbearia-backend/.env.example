DB_NAME=Barbearia_Cortae_DB
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_SSL=false
PORT=3000
# Geocodificação (OpenStreetMap/Nominatim) - transforma o endereço em latitude/longitude
# para calcular a barbearia mais próxima. Não precisa de chave.
# GEOCODING_USER_AGENT=BarberFlow/1.0 (seu-email@exemplo.com)
# GEOCODING_DESABILITADO=false

# E-mail (notificações para clientes e para a barbearia) - qualquer servidor SMTP.
# Gmail: crie uma "senha de app" em https://myaccount.google.com/apppasswords
# Sem estas variáveis os e-mails são apenas simulados (aparecem no console).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seuemail@gmail.com
# SMTP_PASS=senha-de-app-de-16-letras
# SMTP_FROM=seuemail@gmail.com
# Horário do resumo diário enviado à barbearia (horário de Brasília)
# RESUMO_DIARIO_HORA=07:00
